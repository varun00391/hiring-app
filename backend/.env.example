# Application
APP_NAME=HireBot Resume Parser
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# Upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=[".pdf",".doc",".docx"]

# Data storage
DATA_DIR=/tmp/hirebot/data

# SMTP (outbound email) — set SMTP_ENABLED=true to send real emails
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# IMAP (inbound reply polling) — set IMAP_ENABLED=true to poll inbox
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
INBOX_POLL_INTERVAL_SECONDS=120

# Company / recruiter defaults
COMPANY_NAME=HireBot
RECRUITER_SIGNATURE=Alex Morgan\nSenior Recruiter\nHireBot
